# Copy to .env; never commit real credentials.
RESTART_POLICY=unless-stopped
DOCKER_NETWORK_NAME=rag-network
APP_BIND_HOST=127.0.0.1
APP_PORT=8000
BACKEND_PORT=8001

# Cloud.ru OpenAI-compatible embedding API
EMBEDDING_API_URL=https://foundation-models.api.cloud.ru/v1
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
API_KEY=
RAG_RETRIEVAL_TOP_K=8

# Qdrant persistent storage
QDRANT_IMAGE=qdrant/qdrant:latest
QDRANT_CONTAINER_NAME=qdrant
QDRANT_STORAGE_VOLUME=qdrant-storage
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_LOG_LEVEL=INFO
QDRANT_API_KEY=

# Local Python defaults; Compose uses container paths.
DATABASE_PATH=backend/data/appeals.sqlite3
STORAGE_BASE_PATH=backend/data/documents
GIGACHAT_AUTH_KEY_FILE=backend/data/gigachat_auth_key
EMBEDDING_API_KEY_FILE=backend/data/embedding_api_key
APP_API_KEY=
ADMIN_API_KEY=
LAWYER_API_KEY=
OPERATOR_API_KEY=

GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_OAUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
GIGACHAT_API_URL=https://api.giga.chat/v1
GIGACHAT_MODEL=GigaChat-2-pro
GIGACHAT_VERIFY_SSL=true
GIGACHAT_CA_BUNDLE_FILE=
LLM_MASK_PII=false
