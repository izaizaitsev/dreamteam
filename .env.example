# Defaults corresponding to compose.yaml. Do not overwrite an existing .env.
RESTART_POLICY=unless-stopped
DOCKER_NETWORK_NAME=rag-network
EMBEDDING_IMAGE=ghcr.io/huggingface/text-embeddings-inference:86-1.9
EMBEDDING_CONTAINER_NAME=qwen3-embedding
EMBEDDING_PORT=8080
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_CACHE_VOLUME=embedding-cache
EMBEDDING_MAX_BATCH_SIZE=32
RERANKER_IMAGE=vllm/vllm-openai:latest
RERANKER_CONTAINER_NAME=qwen3-reranker
RERANKER_MODEL=Qwen/Qwen3-Reranker-0.6B
RERANKER_PORT=8081
RERANKER_MODEL_NAME=qwen3-reranker
RERANKER_CACHE_VOLUME=reranker-cache
RERANKER_GPU_COUNT=1
RERANKER_GPU_MEMORY_UTILIZATION=0.50
RERANKER_MAX_MODEL_LEN=4096
QDRANT_IMAGE=qdrant/qdrant:latest
QDRANT_CONTAINER_NAME=qdrant
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_STORAGE_VOLUME=qdrant-storage
QDRANT_LOG_LEVEL=INFO
QDRANT_API_KEY=

# Application
APP_HOST=127.0.0.1
APP_PORT=8000
DATABASE_PATH=app/data/appeals.sqlite3
APP_API_KEY=
RAG_RETRIEVAL_TOP_K=30
RAG_RERANK_TOP_K=8

# GigaChat: insert the Authorization key in GIGACHAT_AUTH_KEY.
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_OAUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
GIGACHAT_API_URL=https://api.giga.chat/v1
GIGACHAT_MODEL=GigaChat-2-pro
GIGACHAT_VERIFY_SSL=true
LLM_MASK_PII=false
