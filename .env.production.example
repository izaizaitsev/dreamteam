# Copy to .env.production. Use only with compose.production.yaml and --env-file.
APP_DOMAIN=appeals.example.com
ACME_EMAIL=admin@example.com
ADMIN_USERNAME=admin
# Required, at least 12 characters. Do not reuse the local password.
ADMIN_PASSWORD=
SESSION_TTL_SECONDS=28800
SESSION_COOKIE_SECURE=true

# Required: pin the Qdrant release/digest used by your deployment.
# When migrating existing data, use its current version first.
QDRANT_IMAGE=
QDRANT_API_KEY=
QDRANT_LOG_LEVEL=INFO

EMBEDDING_API_URL=https://foundation-models.api.cloud.ru/v1
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
API_KEY=
RAG_RETRIEVAL_TOP_K=8

GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_OAUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
GIGACHAT_API_URL=https://api.giga.chat/v1
GIGACHAT_MODEL=GigaChat-2-pro
LLM_MASK_PII=true
